// Drona Enterprises - Multi-Tenant Profitability Management System
// Prisma schema based on the ER diagram from the design spec.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & TENANCY
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  // GROUP_ADMIN | COMPANY_ADMIN | STANDARD_USER
  role         String   @default("STANDARD_USER")
  // null = belongs to parent group (Drona Enterprises)
  companyId    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id])
  sessions Session[]
}

model Company {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  // PARENT | TENANT
  type      String   @default("TENANT")
  parentId  String?
  status    String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent           Company?               @relation("CompanyHierarchy", fields: [parentId], references: [id])
  children         Company[]              @relation("CompanyHierarchy")
  users            User[]
  clients          Client[]
  employees        Employee[]
  expenses         Expense[]
  categories       ExpenseCategory[]
  vendors          Vendor[]
  accounts         Account[]
  bills            Bill[]
  customerPayments CustomerPayment[]
  vendorPayments   VendorPayment[]
  financialTxns    FinancialTransaction[]
  importJobs       ImportJob[]
  documents        Document[]
  auditLogs        AuditLog[]
}

// ============================================================
// REFERENCE / MASTER DATA
// ============================================================

model ClientType {
  id        String   @id @default(cuid())
  name      String   @unique
  // e.g. Enterprise, SMB, Strategic, Retail
  createdAt DateTime @default(now())

  clients Client[]
}

model Location {
  id        String   @id @default(cuid())
  name      String   @unique
  country   String?
  createdAt DateTime @default(now())

  clients   Client[]
  employees Employee[]
}

model EmployeeType {
  id        String   @id @default(cuid())
  name      String   @unique
  // e.g. Full-time, Part-time, Contractor
  createdAt DateTime @default(now())

  employees Employee[]
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  employees Employee[]
}

// ============================================================
// BUSINESS MODULES
// ============================================================

model Client {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  code          String
  clientTypeId  String
  locationId    String
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE
  contractValue Float?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  customFields  String?
  source        String?  @default("MANUAL") // MANUAL | EXCEL_IMPORT | CSV_IMPORT | TALLY
  externalId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company                    @relation(fields: [companyId], references: [id])
  clientType    ClientType                 @relation(fields: [clientTypeId], references: [id])
  location      Location                   @relation(fields: [locationId], references: [id])
  revenues      Revenue[]
  allocations   EmployeeClientAllocation[]
  documents     ClientDocument[]
  payments      CustomerPayment[]
  financialTxns FinancialTransaction[]

  @@unique([companyId, code])
}

model ClientDocument {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  category  String   @default("Invoice") // Invoice | Contract | Image | Document | Receipt | Other
  fileUrl   String // base64 or relative URL
  fileType  String // e.g. image/jpeg, image/png, application/pdf
  fileSize  Int? // bytes
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Revenue {
  id           String    @id @default(cuid())
  clientId     String
  date         DateTime
  dueDate      DateTime?
  invoiceNo    String
  description  String?
  quantity     Float     @default(1)
  rate         Float
  amount       Float // Grand Total (including GST)
  items        String? // JSON stringified array of line items [{ name, quantity, rate, gstPercent, amount }]
  subtotal     Float? // Total before tax
  taxAmount    Float? // Total tax / GST amount
  status       String?   @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERDUE
  source       String?   @default("MANUAL") // MANUAL | EXCEL_IMPORT | CSV_IMPORT | TALLY
  externalId   String?
  documentUrl  String?
  documentName String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  payments CustomerPayment[]
}

model Vendor {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  code       String?
  email      String?
  phone      String?
  gstin      String?
  address    String?
  status     String   @default("ACTIVE") // ACTIVE | INACTIVE
  source     String?  @default("MANUAL")
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company       Company                @relation(fields: [companyId], references: [id])
  bills         Bill[]
  payments      VendorPayment[]
  financialTxns FinancialTransaction[]

  @@unique([companyId, name])
}

model Account {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  accountCode String
  accountType String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  parentId    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company       Company                @relation(fields: [companyId], references: [id])
  parent        Account?               @relation("AccountHierarchy", fields: [parentId], references: [id])
  children      Account[]              @relation("AccountHierarchy")
  financialTxns FinancialTransaction[]

  @@unique([companyId, accountCode])
}

model CustomerPayment {
  id              String   @id @default(cuid())
  companyId       String
  revenueId       String
  clientId        String
  paymentDate     DateTime
  amount          Float
  paymentMethod   String   @default("BANK_TRANSFER") // BANK_TRANSFER | CHEQUE | CASH | UPI | OTHER
  referenceNumber String?
  notes           String?
  status          String   @default("ACTIVE") // ACTIVE | REVERSED
  source          String?  @default("MANUAL")
  externalId      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  revenue Revenue @relation(fields: [revenueId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id])
}

model Bill {
  id           String    @id @default(cuid())
  companyId    String
  vendorId     String
  billNumber   String
  billDate     DateTime
  dueDate      DateTime?
  subtotal     Float?
  taxAmount    Float?
  totalAmount  Float
  description  String?
  status       String    @default("UNPAID") // UNPAID | PARTIAL | PAID | OVERDUE
  source       String?   @default("MANUAL")
  externalId   String?
  documentUrl  String?
  documentName String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company  Company         @relation(fields: [companyId], references: [id])
  vendor   Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  payments VendorPayment[]
}

model VendorPayment {
  id              String   @id @default(cuid())
  companyId       String
  billId          String
  vendorId        String
  paymentDate     DateTime
  amount          Float
  paymentMethod   String   @default("BANK_TRANSFER")
  referenceNumber String?
  notes           String?
  status          String   @default("ACTIVE") // ACTIVE | REVERSED
  source          String?  @default("MANUAL")
  externalId      String?

  documentKey      String?
  documentName     String?
  documentType     String?
  documentSize     Int?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id])
}

model FinancialTransaction {
  id              String   @id @default(cuid())
  companyId       String
  transactionDate DateTime
  transactionType String // INVOICE | CUSTOMER_PAYMENT | BILL | VENDOR_PAYMENT | EXPENSE
  referenceType   String? // REVENUE | BILL | EXPENSE | CUSTOMER_PAYMENT | VENDOR_PAYMENT
  referenceId     String?
  accountId       String?
  clientId        String?
  vendorId        String?
  debit           Float    @default(0)
  credit          Float    @default(0)
  amount          Float
  description     String?
  source          String?  @default("MANUAL")
  externalId      String?
  createdAt       DateTime @default(now())

  company Company  @relation(fields: [companyId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])
  client  Client?  @relation(fields: [clientId], references: [id])
  vendor  Vendor?  @relation(fields: [vendorId], references: [id])
}

model Employee {
  id             String    @id @default(cuid())
  companyId      String
  name           String
  code           String
  employeeTypeId String
  departmentId   String
  locationId     String
  designation    String?
  salary         Float     @default(0)
  status         String    @default("ACTIVE") // ACTIVE | INACTIVE
  joiningDate    DateTime?
  email          String?
  phone          String?
  customFields   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company      Company                    @relation(fields: [companyId], references: [id])
  employeeType EmployeeType               @relation(fields: [employeeTypeId], references: [id])
  department   Department                 @relation(fields: [departmentId], references: [id])
  location     Location                   @relation(fields: [locationId], references: [id])
  costs        EmployeeCost[]
  allocations  EmployeeClientAllocation[]

  @@unique([companyId, code])
}

model EmployeeCost {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime
  // SALARY | ALLOWANCE | OVERTIME | BENEFIT | OTHER
  costType    String
  amount      Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model EmployeeClientAllocation {
  id                String    @id @default(cuid())
  employeeId        String
  clientId          String
  allocationPercent Float
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  companyId String
  name      String
  // OPERATIONAL | ADMINISTRATIVE | CAPITAL
  type      String   @default("OPERATIONAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id])
  expenses Expense[]

  @@unique([companyId, name])
}

model Expense {
  id           String   @id @default(cuid())
  companyId    String
  categoryId   String
  date         DateTime
  amount       Float
  description  String?
  source       String?  @default("MANUAL")
  externalId   String?
  documentUrl  String?
  documentName String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model ImportJob {
  id             String    @id @default(cuid())
  companyId      String
  uploadedBy     String
  sourceType     String // EXCEL | CSV | TALLY
  fileName       String
  fileType       String
  s3Bucket       String? // AWS S3 Bucket Name
  s3Key          String? // AWS S3 Object Key
  status         String    @default("UPLOADED") // UPLOADED | PARSING | VALIDATING | READY_FOR_REVIEW | IMPORTING | COMPLETED | PARTIAL | FAILED | CANCELLED
  totalRows      Int       @default(0)
  validRows      Int       @default(0)
  invalidRows    Int       @default(0)
  duplicateRows  Int       @default(0)
  successfulRows Int       @default(0)
  failedRows     Int       @default(0)
  totalDebit     Float?    @default(0)
  totalCredit    Float?    @default(0)
  columnMapping  String? // JSON string
  reconciliation String? // JSON string
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  company Company     @relation(fields: [companyId], references: [id])
  rows    ImportRow[]
}

model ImportRow {
  id             String  @id @default(cuid())
  importJobId    String
  rowNumber      Int
  rawContent     String // JSON string of original uploaded row
  normalizedData String? // JSON string of normalized record
  status         String  @default("PENDING") // PENDING | VALID | INVALID | DUPLICATE | IMPORTED | FAILED
  targetEntity   String? // REVENUE | EXPENSE | CLIENT | VENDOR | BILL | PAYMENT
  targetId       String?
  errorMessage   String?

  importJob ImportJob     @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  errors    ImportError[]
}

model ImportError {
  id           String  @id @default(cuid())
  importRowId  String
  columnName   String?
  errorCode    String
  errorMessage String
  rawText      String?

  importRow ImportRow @relation(fields: [importRowId], references: [id], onDelete: Cascade)
}

model Document {
  id           String   @id @default(cuid())
  companyId    String
  fileName     String
  fileType     String
  fileSize     Int?
  storageKey   String // S3 Key or Storage path identifier
  s3Bucket     String? // AWS S3 Bucket Name
  s3Key        String? // AWS S3 Object Key
  documentType String   @default("GENERAL") // INVOICE | BILL | RECEIPT | CONTRACT | OTHER
  uploadedBy   String?
  createdAt    DateTime @default(now())

  company Company        @relation(fields: [companyId], references: [id])
  links   DocumentLink[]
}

model DocumentLink {
  id         String @id @default(cuid())
  documentId String
  entityType String // CLIENT | REVENUE | BILL | CUSTOMER_PAYMENT | VENDOR_PAYMENT | EXPENSE | EMPLOYEE | VENDOR
  entityId   String

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            String   @id @default(cuid())
  companyId     String?
  userId        String?
  userName      String?
  action        String // CREATE | UPDATE | DELETE | REVERSE | IMPORT
  entityType    String // REVENUE | CUSTOMER_PAYMENT | BILL | VENDOR_PAYMENT | EXPENSE | VENDOR | IMPORT
  entityId      String?
  details       String? // JSON detail summary
  previousValue String? // JSON string
  newValue      String? // JSON string
  createdAt     DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
}

// ============================================================
// SESSION (simple non-JWT auth for demo)
// ============================================================

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
